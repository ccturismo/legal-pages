---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { destinos } from '../data/destinos';
import { MENSAGEM_GERAL } from '../data/contato';

const diferenciais = [
	{
		titulo: 'Viagens em grupo',
		texto:
			'Excursões com roteiro pronto, guia acompanhando e um grupo para fazer a viagem render.',
		itens: ['Roteiro e passeios definidos', 'Guia durante toda a viagem', 'Hospedagem e refeições combinadas'],
	},
	{
		titulo: 'Saída de São José dos Campos',
		texto:
			'Os embarques saem da cidade e da região, sem conexão, sem aeroporto e sem deslocamento até a capital.',
		itens: ['Ônibus fretado', 'Pontos de embarque na região', 'Ida e volta no mesmo grupo'],
	},
	{
		titulo: 'Destinos pelo Brasil',
		texto:
			'Praias, serras, cidades históricas, santuários e parques — com hospedagem sempre no Brasil.',
		itens: [
			'Bate-volta e viagens de vários dias',
			'Alguns roteiros cruzam a fronteira por um dia',
			'Grupos de todas as idades',
		],
	},
];
---

<Base
	title="C&C Turismo — Excursões e viagens em grupo saindo de São José dos Campos"
	description="A C&C Turismo organiza excursões e viagens em grupo de ônibus para destinos no Brasil, com saídas de São José dos Campos e região."
>
	<section class="hero">
		<div class="container">
			<span class="arco" aria-hidden="true"></span>
			<h1 class="display">Excursões e viagens em grupo pelo Brasil</h1>
			<p class="lead">
				Saímos de São José dos Campos de ônibus, com roteiro pronto, guia
				acompanhando e o seguro dos passageiros já incluso.
			</p>
			<div class="acoes">
				<BotaoWhatsApp mensagem={MENSAGEM_GERAL} />
				<a class="botao botao-secundario" href="#destinos">Ver destinos</a>
			</div>
		</div>
	</section>

	<section class="secao" id="viagens">
		<div class="container">
			<h2>Como são nossas viagens</h2>
			<p class="secao-intro">
				A gente cuida do roteiro, do transporte e da logística. Você escolhe o
				destino e a data.
			</p>
			<div class="cartoes">
				{
					diferenciais.map((d) => (
						<article class="cartao">
							<h3>{d.titulo}</h3>
							<p>{d.texto}</p>
							<ul>
								{d.itens.map((i) => (
									<li>{i}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</section>

	<section class="secao secao-alt" id="destinos">
		<div class="container">
			<h2>Para onde a gente vai</h2>
			<p class="secao-intro">
				Destinos que a C&C Turismo atende, do bate-volta à viagem de vários
				dias. As datas de cada saída mudam ao longo do ano — fale com a gente
				para saber as próximas.
			</p>
			<ul class="destinos">
				{
					destinos.map((d) => (
						<li class="destino">
							<a href={`/destinos/${d.slug}/`}>
								{
									d.imagem ? (
										<Image
											src={d.imagem}
											alt=""
											width={640}
											widths={[320, 640]}
											sizes="(max-width: 48rem) 90vw, 320px"
											loading="lazy"
										/>
									) : (
										<div class="sem-foto" aria-hidden="true">
											<span class="arco" />
										</div>
									)
								}
								<div class="destino-texto">
									<span class="destino-uf">{d.uf}</span>
									<h3>{d.nome}</h3>
									<p>{d.descricao}</p>
									{d.duracao && <span class="destino-meta">{d.duracao}</span>}
								</div>
							</a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="secao" id="contato">
		<div class="container">
			<h2>Contato</h2>
			<p class="secao-intro">
				Escreva para a gente e retornamos com os próximos roteiros, datas e
				pontos de embarque.
			</p>
			<p class="contato-acao"><BotaoWhatsApp mensagem={MENSAGEM_GERAL} /></p>
			<ul class="contato-lista">
				<li>
					<strong>Atendimento:</strong>
					<a href="mailto:contato@ccturismo.com.br">contato@ccturismo.com.br</a>
				</li>
				<li>
					<strong>Privacidade e dados pessoais:</strong>
					<a href="mailto:privacidade@ccturismo.com.br">privacidade@ccturismo.com.br</a>
				</li>
				<li><strong>Onde estamos:</strong> São José dos Campos/SP</li>
			</ul>
		</div>
	</section>
</Base>
